{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.3.0",
  "identifier": "ai.jarvis.companion",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Jarvis",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "backgroundColor": "#05080d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/jarvis/": "backend/jarvis/",
      "../../backend/requirements.txt": "backend/requirements.txt"
    }
  }
}
